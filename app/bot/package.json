{
  "name": "@bot-thoi-gian-bieu/bot",
  "version": "0.1.0",
  "description": "Mezon bot quan ly lich trinh, su kien va nhac nho tu dong",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:local": "node dist/main",
    "start:prod": "node scripts/migrate.cjs && node dist/main",
    "migrate": "node scripts/migrate.cjs",
    "lint": "eslint --config .eslintrc.js --resolve-plugins-relative-to . \"src/**/*.ts\" \"../../test/bot/**/*.ts\"",
    "lint:fix": "eslint --config .eslintrc.js --resolve-plugins-relative-to . \"src/**/*.ts\" \"../../test/bot/**/*.ts\" --fix",
    "test": "jest",
    "test:ci": "jest --ci --maxWorkers=2"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "long": "^5.3.2",
    "mezon-sdk": "^2.8.46",
    "pg": "^8.13.1",
    "protobufjs": "^7.5.9",
    "read-excel-file": "^9.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
